{
  "_comment": "OpenZeppelin Defender Sentinel configuration for Resurgence Protocol.",
  "_docs": "https://docs.openzeppelin.com/defender/sentinel",
  "_import": "Import via Defender API or dashboard. Replace placeholder addresses before use.",
  "sentinels": [
    {
      "name": "Resurgence — Contract Upgrade Watch",
      "type": "BLOCK",
      "network": "matic",
      "addresses": [
        "${RESURGE_TOKEN_ADDRESS}",
        "${STAKING_MANAGER_ADDRESS}",
        "${REWARD_DISTRIBUTOR_ADDRESS}",
        "${RESURGE_STAKING_POOL_ADDRESS}"
      ],
      "abi": [
        {"type": "event", "name": "Upgraded", "inputs": [{"name": "implementation", "type": "address", "indexed": true}]}
      ],
      "conditions": {
        "event": [{"signature": "Upgraded(address)"}]
      },
      "notify": {
        "channels": ["email", "discord"],
        "message": "⚠️ CRITICAL: Contract upgrade detected on {{address}}. New implementation: {{implementation}}. Verify this was authorized by governance."
      }
    },
    {
      "name": "Resurgence — Emergency Pause Watch",
      "type": "BLOCK",
      "network": "matic",
      "addresses": [
        "${STAKING_MANAGER_ADDRESS}",
        "${REWARD_DISTRIBUTOR_ADDRESS}"
      ],
      "abi": [
        {"type": "event", "name": "Paused", "inputs": [{"name": "account", "type": "address"}]},
        {"type": "event", "name": "Unpaused", "inputs": [{"name": "account", "type": "address"}]}
      ],
      "conditions": {
        "event": [
          {"signature": "Paused(address)"},
          {"signature": "Unpaused(address)"}
        ]
      },
      "notify": {
        "channels": ["email", "discord", "pagerduty"],
        "message": "🚨 Protocol pause event on {{address}} by {{account}}."
      }
    },
    {
      "name": "Resurgence — Large Claim Monitor",
      "type": "BLOCK",
      "network": "matic",
      "addresses": ["${REWARD_DISTRIBUTOR_ADDRESS}"],
      "abi": [
        {"type": "event", "name": "RewardsDistributed", "inputs": [{"name": "pool", "type": "address"}, {"name": "amount", "type": "uint256"}]}
      ],
      "conditions": {
        "event": [{"signature": "RewardsDistributed(address,uint256)"}],
        "transaction": {
          "status": ["success"]
        }
      },
      "notify": {
        "channels": ["discord"],
        "message": "💰 Rewards distributed: {{amount}} RESURGE to pool {{pool}}."
      }
    },
    {
      "name": "Resurgence — Governance Activity",
      "type": "BLOCK",
      "network": "matic",
      "addresses": ["${GOVERNANCE_ADDRESS}"],
      "abi": [
        {"type": "event", "name": "ProposalCreated", "inputs": [{"name": "proposalId", "type": "uint256", "indexed": false}, {"name": "proposer", "type": "address", "indexed": false}, {"name": "description", "type": "string"}]},
        {"type": "event", "name": "ProposalExecuted", "inputs": [{"name": "proposalId", "type": "uint256", "indexed": false}]},
        {"type": "event", "name": "ProposalCanceled", "inputs": [{"name": "proposalId", "type": "uint256", "indexed": false}]}
      ],
      "conditions": {
        "event": [
          {"signature": "ProposalCreated(uint256,address,string)"},
          {"signature": "ProposalExecuted(uint256)"},
          {"signature": "ProposalCanceled(uint256)"}
        ]
      },
      "notify": {
        "channels": ["discord", "email"],
        "message": "🗳️ Governance event on proposal {{proposalId}} by {{proposer}}."
      }
    }
  ]
}
