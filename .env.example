# Resurgence Protocol Environment Configuration

# Private Key for Deployment (DO NOT COMMIT THE ACTUAL .env FILE)
PRIVATE_KEY=your_private_key_here

# ─── RPC URLs ──────────────────────────────────────────────────────────────────

# Hub chain (Arbitrum)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Tier 1 spokes
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Tier 2 spokes
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Infura/Alchemy (optional — improves reliability over public RPCs)
INFURA_PROJECT_ID=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key

# ─── Block Explorer API Keys ───────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
OPTIMISM_API_KEY=your_optimism_etherscan_api_key
SNOWTRACE_API_KEY=your_snowtrace_api_key

# ─── Frontend Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=your_wallet_connect_project_id
NEXT_PUBLIC_DEFAULT_CHAIN_ID=421614

# Hub — Arbitrum Sepolia (testnet)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RESURGE_TOKEN_ADDRESS=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_TIMELOCK_ADDRESS=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_REWARD_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RESURGE_STAKING_POOL_ADDRESS=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_GOVERNANCE_ADDRESS=

# Hub — Arbitrum One (mainnet)
NEXT_PUBLIC_ARBITRUM_RESURGE_TOKEN_ADDRESS=
NEXT_PUBLIC_ARBITRUM_TIMELOCK_ADDRESS=
NEXT_PUBLIC_ARBITRUM_REWARD_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_ARBITRUM_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_ARBITRUM_RESURGE_STAKING_POOL_ADDRESS=
NEXT_PUBLIC_ARBITRUM_GOVERNANCE_ADDRESS=

# Generic fallbacks (legacy Polygon hub — deprecated)
NEXT_PUBLIC_RESURGE_TOKEN_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_RESURGE_STAKING_POOL_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=

# Spoke chains — Phase 10 (StakingPoolManager + CrossChainSender per chain)
NEXT_PUBLIC_POLYGON_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_POLYGON_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_AMOY_STAKING_POOL_MANAGER_ADDRESS=

NEXT_PUBLIC_BSC_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_BSC_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_STAKING_POOL_MANAGER_ADDRESS=

NEXT_PUBLIC_BASE_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_BASE_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_STAKING_POOL_MANAGER_ADDRESS=

NEXT_PUBLIC_ETHEREUM_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_SEPOLIA_STAKING_POOL_MANAGER_ADDRESS=

NEXT_PUBLIC_OPTIMISM_STAKING_POOL_MANAGER_ADDRESS=

NEXT_PUBLIC_AVALANCHE_STAKING_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_AVALANCHE_FUJI_STAKING_POOL_MANAGER_ADDRESS=

# Subgraph — hub (Arbitrum Sepolia)
NEXT_PUBLIC_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-protocol

# Subgraph — spoke chains (fill in after spoke deployments + subgraph syncs)
NEXT_PUBLIC_AMOY_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-amoy
NEXT_PUBLIC_BSC_TESTNET_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-bsc-testnet
NEXT_PUBLIC_BASE_SEPOLIA_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-base-sepolia
NEXT_PUBLIC_BSC_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-bsc
NEXT_PUBLIC_BASE_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-base
NEXT_PUBLIC_POLYGON_SUBGRAPH_URL=https://subgraph.baals.network/subgraphs/name/resurgence-polygon

# CrossChainReceiver address on hub (set after deployCrossChainReceiver.js)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_CROSS_CHAIN_RECEIVER_ADDRESS=
NEXT_PUBLIC_ARBITRUM_CROSS_CHAIN_RECEIVER_ADDRESS=

# CrossChainSender addresses on spokes (set after deploySpoke.js for each chain)
NEXT_PUBLIC_AMOY_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BSC_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_BASE_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_POLYGON_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_ETHEREUM_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_SEPOLIA_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_OPTIMISM_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_AVALANCHE_CROSS_CHAIN_SENDER_ADDRESS=
NEXT_PUBLIC_AVALANCHE_FUJI_CROSS_CHAIN_SENDER_ADDRESS=

# ─── Deployment Configuration ──────────────────────────────────────────────────
RESURGE_REWARD_RATE=1
INITIAL_TOKEN_SUPPLY=1000000000000000000000000000
TIMELOCK_MIN_DELAY=3600
GOVERNANCE_VOTING_DELAY=1
GOVERNANCE_VOTING_PERIOD=50400
GOVERNANCE_QUORUM_PERCENTAGE=4

# ─── The Graph (self-hosted VPS) ───────────────────────────────────────────────
GRAPH_POSTGRES_PASSWORD=your_graph_postgres_password

# ─── Monitoring & Alerting ─────────────────────────────────────────────────────
TENDERLY_PROJECT_ID=your_tenderly_project_id
TENDERLY_USERNAME=your_tenderly_username
TENDERLY_ACCESS_KEY=your_tenderly_access_key

# ─── Development ──────────────────────────────────────────────────────────────
NODE_ENV=development
FORK_ARBITRUM_SEPOLIA=false
